# Glasshouse — Umgebungsvariablen
#
# WICHTIG: Die App laeuft ohne jeden Schluessel. Ohne Helius weicht sie auf
# den oeffentlichen Solana-Knoten aus; Kurse, Charts, Depotansicht und der
# Nachbauen-Ablauf funktionieren damit vollstaendig. Nur die Ranglisten-
# Suche braucht einen eigenen RPC-Zugang (siehe unten).
#
# Diese Datei nach .env.local kopieren und ausfuellen:
#   cp .env.local.example .env.local


# ── Optional: eigener RPC-Zugang ─────────────────────────────────────────
# Nur noetig fuer die Rangliste. Sie muss alle Halter eines Tokens
# auflisten (getTokenLargestAccounts), was der oeffentliche Knoten mit
# HTTP 429 sperrt. Kostenloses Kontingent auf helius.dev reicht.
HELIUS_API_KEY=

# ── Optional: Anmeldung ueber mehrere Server-Neustarts hinweg ────────────
# Ohne Wert wird beim Start ein zufaelliger Schluessel erzeugt — Anmeldungen
# ueberleben dann keinen Neustart. Fuer die lokale Entwicklung genuegt das.
# Erzeugen mit:  openssl rand -hex 32
AUTH_SECRET=

# Schuetzt /api/refresh vor fremden Aufrufen. Nur fuer den Betrieb noetig.
REFRESH_SECRET=

# ── Optional: Datenbank ──────────────────────────────────────────────────
# Ohne Supabase laufen Konten im Arbeitsspeicher und gehen beim Neustart
# verloren. Zum Entwickeln und fuer die Vorfuehrung nicht erforderlich.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: Beteiligung an Jupiter-Gebuehren ───────────────────────────
# Nur wirksam, wenn beide Werte gesetzt sind.
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=
